{
  "name": "journal-kidney-pp-ua",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:preflight && npm run test:contributors && npm run test:feed && npm run test:issues && npm run test:english-articles && npm run test:publication-gate && npm run test:editor-triage && npm run test:draft-export && npm run test:unsaved-pdf-guard && npm run test:english-notices && npm run test:release-verification && npm run test:english-atlas && npm run test:vercel-deploy-policy && npm run test:international-contributors && npm run test:robots && next build",
    "start": "next start",
    "lint": "eslint",
    "test:preflight": "node --experimental-strip-types --test tests/jrs-preflight.test.mjs",
    "test:contributors": "node --experimental-strip-types --test tests/jrs-contributors.test.mjs",
    "test:feed": "node --experimental-strip-types --test tests/jrs-feed.test.mjs",
    "test:issues": "node --experimental-strip-types --test tests/jrs-issue-preparation.test.mjs",
    "test:english-articles": "node --experimental-strip-types --test tests/jrs-english-articles.test.mjs",
    "test:publication-gate": "node --experimental-strip-types --test tests/jrs-publication-gate.test.mjs",
    "test:editor-triage": "node --experimental-strip-types --test tests/jrs-editor-triage.test.mjs",
    "test:draft-export": "node --experimental-strip-types --test tests/jrs-draft-export.test.mjs",
    "test:unsaved-pdf-guard": "node --test tests/jrs-unsaved-pdf-guard.test.mjs",
    "test:english-notices": "node --experimental-strip-types --test tests/jrs-english-notices.test.mjs",
    "test:release-verification": "node --experimental-strip-types --test tests/jrs-release-verification.test.mjs",
    "verify:live": "node scripts/verify-jrs-live.mjs",
    "test:english-atlas": "node --experimental-strip-types --test tests/jrs-english-atlas.test.mjs",
    "test:vercel-deploy-policy": "node --test tests/jrs-vercel-deploy-policy.test.mjs",
    "test:international-contributors": "node --experimental-strip-types --test tests/jrs-international-contributors.test.mjs",
    "test:robots": "node --test tests/jrs-robots.test.mjs"
